# Expo app environment variables
# After creating your own .env, restart Expo with: npx expo start -c

# Backend (FastAPI) base URL reachable from your phone on the same Wi-Fi
# Example: http://192.168.1.10:8000
EXPO_PUBLIC_BACKEND_URL=

# Optional: public image URL for the “Namaste” onboarding illustration.
# Example: https://.../namaste.png
EXPO_PUBLIC_NAMASTE_IMAGE_URL=
